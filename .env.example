# .env.example
# -------------
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your actual values

# ---------------------------------------------------------------------------
# IBM watsonx.ai  (primary LLM provider)
# Docs: https://cloud.ibm.com/apidocs/watsonx-ai
# ---------------------------------------------------------------------------
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model to use — recommended options (fastest to most capable):
#   ibm/granite-3-2b-instruct       (fastest, lowest latency — good for demos)
#   ibm/granite-3-8b-instruct       (fast + accurate — recommended default)
#   ibm/granite-20b-code-instruct-v2 (balanced code + language)
#   ibm/granite-34b-code-instruct   (highest quality code reasoning)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ---------------------------------------------------------------------------
# GitHub  (for cloning / analysing repositories via the API)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:8501

# ---------------------------------------------------------------------------
# Agent settings
# ---------------------------------------------------------------------------
# Maximum number of files the repo analyser will inspect per run
REPO_ANALYZER_MAX_FILES=50

# Timeout (seconds) for subprocess test execution
TEST_RUNNER_TIMEOUT=30

# Temporary directory for cloned repos (defaults to system temp if blank)
REPO_CLONE_DIR=

# ---------------------------------------------------------------------------
# Optional: OpenAI-compatible fallback LLM
# Leave blank to use watsonx.ai exclusively.
# Set LLM_PROVIDER=openai to force this provider.
# Supports local models via Ollama (set OPENAI_BASE_URL=http://localhost:11434/v1)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=gpt-4o

# ---------------------------------------------------------------------------
# LLM provider selection (auto / watsonx / openai)
# "auto" tries watsonx first, then openai, then falls back to StubLLMClient.
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto
